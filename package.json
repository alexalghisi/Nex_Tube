{
  "name": "nex-tube",
  "version": "1.0.0",
  "private": true,
  "main": "index.ts",
  "license": "MIT",
  "author": "alexalghisi",
  "description": "YouTube-style player without ads. Audio stays up after the watch screen closes. Expo for phone, tablet, web, and TV.",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "build": "expo export --platform web",
    "build:ios": "expo export --platform ios",
    "build:android": "expo export --platform android",
    "export:web": "expo export --platform web --output-dir dist-web",
    "desktop:web": "node scripts/prepare-desktop.mjs",
    "package:webos": "node scripts/package-webos.mjs",
    "package:android": "bash scripts/package-android.sh",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@expo/metro-runtime": "~57.0.16",
    "@expo/vector-icons": "^15.0.2",
    "@react-native-async-storage/async-storage": "2.2.0",
    "expo": "~57.0.24",
    "expo-audio": "~57.0.5",
    "expo-auth-session": "~57.0.12",
    "expo-crypto": "~57.0.3",
    "expo-status-bar": "~57.0.1",
    "expo-video": "~57.0.5",
    "expo-web-browser": "~57.0.3",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-web": "^0.21.2"
  },
  "devDependencies": {
    "@types/node": "^26.6.2",
    "@types/react": "~19.2.2",
    "typescript": "~6.0.3",
    "vitest": "^3.2.7"
  }
}
